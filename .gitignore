# ── 依赖 ──
# 由 package.json + package-lock.json 还原，体积上万文件，绝不入库
node_modules

# ── 构建产物 ──
# 每次 build 重新生成；CI 里云端自己构建，本地这份不需要进版本库
dist
dist-ssr

# ── 缓存 / 增量编译信息 ──
.vite
*.tsbuildinfo

# ── 环境变量 / 密钥 ──
# 密钥、token、密码一律不进 commit。.env.example 是例外：
# 它只写变量名、不写值，是给协作者的配置模板，必须入库
.env
.env.*
!.env.example

# ── 日志 ──
*.log

# ── 测试覆盖率产物 ──
coverage

# ── 人工验收截图 ──
# 用 Playwright 驱动本机浏览器截的效果图（默认态 / 满签爆发 / 移动端 / 减少动效）。
# 只在本地留作前后对比，不参与构建也不进版本库。
# 注意 dist/ 已经忽略，这里忽略的是开发期手工截图，别把两者搞混
shots/

# ── 编辑器 / 操作系统 ──
.vscode/*
!.vscode/settings.json
.idea
.DS_Store
Thumbs.db

# ── 本机私有配置 ──
*.local
