{
  "name": "checkin-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "test:toolbox": "node scripts/toolbox-check.mjs",
    "test:appearance": "node scripts/appearance-check.mjs",
    "test:orphan": "node scripts/orphan-check.mjs",
    "test:acceptance": "node scripts/acceptance-check.mjs",
    "test:drag": "node scripts/drag-check.mjs",
    "probe:backdrop": "node scripts/backdrop-probe.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
